---
import type { MarkdownHeading } from "astro";
import MermaidEnhancer from "../components/MermaidEnhancer.astro";
import MobileToc from "../components/MobileToc.astro";
import MobileTopBar from "../components/MobileTopBar.astro";
import SearchBox from "../components/SearchBox.astro";
import SidebarSection from "../components/SidebarSection.astro";
import TableOfContents from "../components/TableOfContents.astro";
import ThemeInitScript from "../components/ThemeInitScript.astro";
import ThemeToggle from "../components/ThemeToggle.astro";
import type { SidebarSection as SidebarSectionType } from "../lib/navigation";
import { siteConfig, withBasePath } from "../lib/site-config";
import "../styles/global.css";

interface Props {
  description?: string;
  docKind?: string;
  hasMermaid?: boolean;
  headings?: MarkdownHeading[];
  navigation: SidebarSectionType[];
  title: string;
  // "haddock" forces the TOC drawer on with an empty list skeleton; the
  // Haddock embed populates it client-side from the iframe document.
  tocVariant?: "headings" | "haddock";
}

const {
  description = siteConfig.site.description,
  docKind = "default",
  hasMermaid = false,
  headings = [],
  navigation,
  title,
  tocVariant = "headings",
} = Astro.props;

const currentPath = Astro.url.pathname;
const pageTitle =
  `${title} | ${siteConfig.site.title} ${siteConfig.site.tagline}`.trim();
const footerText =
  siteConfig.site.footerText ??
  `© ${new Date().getFullYear()} ${siteConfig.site.title}`;
const theme = siteConfig.theme;
const themeModes = siteConfig.themeModes;
const repoUrl = siteConfig.repo?.repoUrl ?? null;

// When themeModes is enabled, the dark theme is the build-time
// baseline (matches the :root cascade in the generated palette.css).
// The inline pre-paint script swaps it for the light theme if the
// reader prefers light AND has not made an explicit choice.
const initialTheme = themeModes ? themeModes.dark : theme;
const htmlClass = initialTheme === "cortex-light" ? "light" : "dark";
const initialMode = themeModes ? "dark" : null;

// Pretty repo label — strip protocol + trailing slash, keep org/repo.
const repoLabel = repoUrl
  ? repoUrl.replace(/^https?:\/\/(www\.)?/, "").replace(/\/+$/, "")
  : null;

const fontFamilies =
  "family=IBM+Plex+Sans:wght@300;400;500;600;700&family=JetBrains+Mono:wght@400;500;600&display=swap";

const tocEnabled =
  tocVariant === "haddock" ||
  headings.filter((heading) => heading.depth >= 2 && heading.depth <= 4)
    .length > 0;
---

<!doctype html>
<html
  lang="en"
  class={htmlClass}
  data-theme={initialTheme}
  data-mode={initialMode}
  data-mode-light={themeModes?.light ?? null}
  data-mode-dark={themeModes?.dark ?? null}
>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{pageTitle}</title>
    {description && <meta name="description" content={description} />}
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href={`https://fonts.googleapis.com/css2?${fontFamilies}`}
      rel="stylesheet"
    />
    <link
      rel="stylesheet"
      href="https://cdn.jsdelivr.net/npm/katex@0.16.22/dist/katex.min.css"
      crossorigin="anonymous"
    />
    <ThemeInitScript />
    <script is:inline>
      // Restore collapsed state + user-dragged sidebar width before
      // paint to avoid layout flicker.
      try {
        const root = document.documentElement;
        const sidebar = localStorage.getItem("docs-sidebar-state");
        const toc = localStorage.getItem("docs-toc-state");
        if (sidebar === "collapsed") root.dataset.sidebar = "collapsed";
        if (toc === "collapsed") root.dataset.toc = "collapsed";
        const widthRaw = localStorage.getItem("docs-sidebar-width");
        const width = widthRaw ? parseFloat(widthRaw) : NaN;
        if (!isNaN(width) && width >= 200 && width <= 520) {
          root.style.setProperty("--docs-sidebar-natural", width + "px");
        }
      } catch {
        /* localStorage may be unavailable */
      }
    </script>
  </head>
  <body data-docs-mermaid={hasMermaid} data-toc-enabled={tocEnabled}>
    <MobileTopBar hasToc={tocEnabled} themeModes={themeModes} />

    <aside id="docs-sidebar" class="docs-sidebar" aria-label="Site navigation">
      <div class="docs-sidebar-expanded">
        <header class="docs-sidebar-header">
          <a href={withBasePath()} class="docs-sidebar-brand">
            <h1>{siteConfig.site.title}</h1>
            <p>{siteConfig.site.tagline}</p>
          </a>
          <button
            type="button"
            class="docs-rail-button docs-rail-button-inline"
            data-collapse="sidebar"
            aria-label="Collapse navigation"
            aria-controls="docs-sidebar"
          >
            <svg
              viewBox="0 0 16 16"
              fill="none"
              stroke="currentColor"
              stroke-width="1.6"
              aria-hidden="true"
            >
              <path
                stroke-linecap="round"
                stroke-linejoin="round"
                d="M10.5 3.5L6 8l4.5 4.5"></path>
            </svg>
          </button>
          {
            /*
            Mobile-only close. Shares the `data-mobile-menu-toggle`
            attribute with the top-bar hamburger, so the layout's
            existing toggle handler closes the drawer when the
            button is tapped from inside the open drawer.
          */
          }
          <button
            type="button"
            class="docs-sidebar-close"
            data-mobile-menu-toggle
            aria-label="Close navigation"
            aria-controls="docs-sidebar"
          >
            <svg
              viewBox="0 0 16 16"
              fill="none"
              stroke="currentColor"
              stroke-width="1.6"
              aria-hidden="true"
            >
              <path
                stroke-linecap="round"
                stroke-linejoin="round"
                d="M4 4l8 8M12 4l-8 8"></path>
            </svg>
          </button>
        </header>

        <nav class="docs-sidebar-nav">
          {
            navigation.map((section) => (
              <SidebarSection currentPath={currentPath} section={section} />
            ))
          }
        </nav>

        {
          repoUrl && (
            <a
              class="docs-sidebar-repo"
              href={repoUrl}
              target="_blank"
              rel="noopener noreferrer"
              aria-label={`Repository: ${repoLabel}`}
            >
              <svg
                class="docs-sidebar-repo-glyph"
                viewBox="0 0 16 16"
                fill="currentColor"
                aria-hidden="true"
              >
                <path d="M8 0C3.58 0 0 3.58 0 8c0 3.54 2.29 6.53 5.47 7.59.4.07.55-.17.55-.38 0-.19-.01-.82-.01-1.49-2.01.37-2.53-.49-2.69-.94-.09-.23-.48-.94-.82-1.13-.28-.15-.68-.52-.01-.53.63-.01 1.08.58 1.23.82.72 1.21 1.87.87 2.33.66.07-.52.28-.87.51-1.07-1.78-.2-3.64-.89-3.64-3.95 0-.87.31-1.59.82-2.15-.08-.2-.36-1.02.08-2.12 0 0 .67-.21 2.2.82.64-.18 1.32-.27 2-.27.68 0 1.36.09 2 .27 1.53-1.04 2.2-.82 2.2-.82.44 1.1.16 1.92.08 2.12.51.56.82 1.27.82 2.15 0 3.07-1.87 3.75-3.65 3.95.29.25.54.73.54 1.48 0 1.07-.01 1.93-.01 2.2 0 .21.15.46.55.38A8.013 8.013 0 0 0 16 8c0-4.42-3.58-8-8-8z" />
              </svg>
              <span class="docs-sidebar-repo-label">{repoLabel}</span>
              <svg
                class="docs-sidebar-repo-external"
                viewBox="0 0 12 12"
                fill="none"
                stroke="currentColor"
                stroke-width="1.4"
                aria-hidden="true"
              >
                <path
                  d="M4 8l4-4M5 4h3v3"
                  stroke-linecap="round"
                  stroke-linejoin="round"
                />
              </svg>
            </a>
          )
        }

        <SearchBox />

        <footer class="docs-sidebar-footer">
          <p>{footerText}</p>
          {themeModes && <ThemeToggle modes={themeModes} />}
        </footer>
      </div>

      <div class="docs-sidebar-rail" aria-hidden="true">
        <button
          type="button"
          class="docs-rail-button"
          data-expand="sidebar"
          aria-label="Expand navigation"
          aria-controls="docs-sidebar"
        >
          <svg
            viewBox="0 0 16 16"
            fill="none"
            stroke="currentColor"
            stroke-width="1.6"
            aria-hidden="true"
          >
            <path
              stroke-linecap="round"
              stroke-linejoin="round"
              d="M5.5 3.5L10 8l-4.5 4.5"></path>
          </svg>
        </button>
      </div>

      <div
        class="docs-sidebar-drag"
        data-docs-sidebar-drag
        role="separator"
        aria-orientation="vertical"
        aria-label="Resize navigation"
        aria-valuenow="280"
        aria-valuemin="200"
        aria-valuemax="520"
      >
      </div>
    </aside>

    {
      tocEnabled && (
        <aside id="docs-toc" class="docs-toc" aria-label="Table of contents">
          <div class="docs-toc-expanded">
            <div class="docs-toc-header">
              <span class="docs-toc-title">Contents</span>
              <button
                type="button"
                class="docs-rail-button docs-rail-button-inline"
                data-collapse="toc"
                aria-label="Collapse table of contents"
                aria-controls="docs-toc"
              >
                <svg
                  viewBox="0 0 16 16"
                  fill="none"
                  stroke="currentColor"
                  stroke-width="1.6"
                  aria-hidden="true"
                >
                  <path
                    stroke-linecap="round"
                    stroke-linejoin="round"
                    d="M10.5 3.5L6 8l4.5 4.5"
                  />
                </svg>
              </button>
            </div>
            {tocVariant === "haddock" ? (
              <nav
                class="docs-toc-nav docs-toc-nav-haddock"
                aria-label="On this page"
              >
                <p class="docs-toc-eyebrow">On this page</p>
                <ol class="docs-toc-list" data-haddock-toc />
              </nav>
            ) : (
              <TableOfContents headings={headings} />
            )}
          </div>

          <div class="docs-toc-rail" aria-hidden="true">
            <button
              type="button"
              class="docs-rail-button"
              data-expand="toc"
              aria-label="Expand table of contents"
              aria-controls="docs-toc"
            >
              <svg
                viewBox="0 0 16 16"
                fill="none"
                stroke="currentColor"
                stroke-width="1.6"
                aria-hidden="true"
              >
                <path
                  stroke-linecap="round"
                  stroke-linejoin="round"
                  d="M5.5 3.5L10 8l-4.5 4.5"
                />
              </svg>
            </button>
          </div>
        </aside>
      )
    }

    <main class="docs-main">
      <div class="docs-main-inner">
        <article
          class={`prose docs-prose docs-prose-${docKind} max-w-none`}
          data-doc-kind={docKind}
        >
          <slot />
        </article>
      </div>
    </main>

    <div id="mobile-overlay" class="docs-mobile-overlay"></div>

    <script>
      import { initModeToggle } from "../lib/mode-toggle";
      import { initPanelState } from "../lib/panel-state";
      import { initSidebarDrag } from "../lib/sidebar-drag";
      import { initMobileDrawer } from "../lib/mobile-drawer";
      import { attachScrollSpy, type ScrollSpyEntry } from "../lib/scroll-spy";

      // Run once per page load. Each init() is a no-op when its
      // target elements aren't in the DOM (e.g. the sidebar drag
      // handle is absent on the haddock-iframe variant).
      initModeToggle();
      initPanelState();
      initSidebarDrag();
      initMobileDrawer();

      // TOC scroll-spy. Shared with the Haddock-iframe variant via
      // lib/scroll-spy.ts; the iframe passes its own contentWindow
      // as the scroll source.
      {
        const tocItems = Array.from(
          document.querySelectorAll<HTMLElement>("[data-toc-anchor]"),
        );
        const article = document.querySelector("article.prose");
        const entries = tocItems
          .map((item) => {
            const id = item.dataset.tocAnchor;
            const heading = id
              ? (article?.querySelector<HTMLElement>(`#${CSS.escape(id)}`) ??
                null)
              : null;
            return id && heading ? { id, item, heading } : null;
          })
          .filter((entry): entry is ScrollSpyEntry => entry !== null);
        attachScrollSpy(entries);
      }
    </script>

    <MermaidEnhancer />
  </body>
</html>
