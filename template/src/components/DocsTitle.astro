---
import type { CollectionEntry } from "astro:content";
import CopySourceButton from "./CopySourceButton.astro";
import DocBadges from "./DocBadges.astro";
import { kebabToTitle } from "../lib/site-config";

interface Props {
  doc: CollectionEntry<"docs">;
}

const { doc } = Astro.props;
const { data } = doc;

// Normalise the doc id into a breadcrumb of title-cased segments. The id
// preserves source path (e.g. "guides/getting-started") so it works as a
// slug-line without pulling in navigation config.
const rawId = doc.id.replace(/\.(md|mdx)$/i, "").replace(/\\/g, "/");
const isIndex = rawId === "index" || rawId.endsWith("/index");
const trimmedId = isIndex ? rawId.replace(/\/?index$/i, "") : rawId;
const crumbs = trimmedId
  .split("/")
  .filter((segment) => segment !== "")
  .map((segment) => kebabToTitle(segment));

// Copy-source button rendered to the right of the last line of the
// ingress copy. Floats inside whichever block carries that last line
// so it tracks the line's baseline instead of dropping onto its own
// row. Hidden on the root page — there's no useful path to copy.
const commandTarget = trimmedId;
const showCommand = commandTarget !== "";

// Raw markdown source for the copy button. doc.body is the body
// content with frontmatter stripped — exactly what a reader wants
// when "copying the source" of a doc page (the prose itself, ready
// to paste into another file or chat). Falls back to empty so the
// data-attribute is always a string.
const docSource = doc.body ?? "";

function normaliseAuthors(
  primary: string | string[] | undefined,
  plural: string | string[] | undefined,
): string[] {
  const pool: string[] = [];
  if (typeof primary === "string") pool.push(primary);
  else if (Array.isArray(primary)) pool.push(...primary);
  if (typeof plural === "string") pool.push(plural);
  else if (Array.isArray(plural)) pool.push(...plural);
  return Array.from(new Set(pool.map((name) => name.trim()).filter(Boolean)));
}

function formatDate(
  value: Date | undefined,
): { iso: string; label: string } | null {
  if (!value) return null;
  const iso = value.toISOString().slice(0, 10);
  const label = value.toLocaleDateString("en-US", {
    year: "numeric",
    month: "long",
    day: "numeric",
  });
  return { iso, label };
}

const authors = normaliseAuthors(data.author, data.authors);
const published = formatDate(data.date);
const updated = formatDate(data.updated);

const hasByline = authors.length > 0 || Boolean(published) || Boolean(updated);
const hasBreadcrumb = crumbs.length > 0;

// Pick the host for the floated command chip — the LAST ingress block.
// Order of preference: byline → description → head row → breadcrumb.
// That keeps the chip baseline-locked to whichever line ends the
// ingress copy on every page shape.
const commandSlot: "byline" | "description" | "head" | "breadcrumb" | "none" =
  !showCommand
    ? "none"
    : hasByline
      ? "byline"
      : data.description
        ? "description"
        : hasBreadcrumb
          ? "head"
          : "head";
---

<header class="docs-title" data-has-breadcrumb={hasBreadcrumb}>
  {
    hasBreadcrumb && (
      <nav class="docs-title-breadcrumb" aria-label="Document location">
        {crumbs.map((crumb, index) => (
          <>
            {index > 0 && (
              <span class="docs-title-breadcrumb-sep" aria-hidden="true">
                /
              </span>
            )}
            <span class="docs-title-breadcrumb-crumb">{crumb}</span>
          </>
        ))}
      </nav>
    )
  }

  <div class="docs-title-head">
    {
      commandSlot === "head" && (
        <CopySourceButton source={docSource} target={commandTarget} />
      )
    }
    <h1 class="docs-title-heading">{data.title}</h1>
    <DocBadges doc={doc} />
  </div>

  {
    data.description && (
      <p class="docs-title-description">
        {commandSlot === "description" && (
          <CopySourceButton source={docSource} target={commandTarget} />
        )}
        {data.description}
      </p>
    )
  }

  {
    hasByline && (
      <p class="docs-title-byline">
        {commandSlot === "byline" && (
          <CopySourceButton source={docSource} target={commandTarget} />
        )}
        {authors.length > 0 && (
          <span class="docs-title-byline-authors">
            {authors.map((author, index) => (
              <>
                {index > 0 && (
                  <span class="docs-title-byline-sep" aria-hidden="true">
                    ·
                  </span>
                )}
                <span class="docs-title-byline-author">{author}</span>
              </>
            ))}
          </span>
        )}
        {published && (
          <>
            {authors.length > 0 && (
              <span class="docs-title-byline-sep" aria-hidden="true">
                ·
              </span>
            )}
            <time class="docs-title-byline-date" datetime={published.iso}>
              {published.label}
            </time>
          </>
        )}
        {updated && (
          <>
            <span class="docs-title-byline-sep" aria-hidden="true">
              ·
            </span>
            <span class="docs-title-byline-updated">
              Updated <time datetime={updated.iso}>{updated.label}</time>
            </span>
          </>
        )}
      </p>
    )
  }

  <hr class="docs-title-divider" />
</header>

<script>
  document
    .querySelectorAll<HTMLButtonElement>("[data-docs-title-command]")
    .forEach((button) => {
      const status = button.querySelector<HTMLElement>(
        ".docs-title-command-status",
      );
      let resetTimer: number | null = null;
      button.addEventListener("click", async () => {
        const source = button.dataset.source ?? "";
        try {
          await navigator.clipboard.writeText(source);
          button.dataset.copied = "true";
          if (status) status.textContent = "Copied";
        } catch {
          button.dataset.copied = "error";
          if (status) status.textContent = "Copy failed";
        }
        if (resetTimer) window.clearTimeout(resetTimer);
        resetTimer = window.setTimeout(() => {
          delete button.dataset.copied;
          if (status) status.textContent = "";
        }, 1600);
      });
    });
</script>
