---
/*
 * Embeds generated Haddock HTML inside the docs shell.
 *
 * The iframe is same-origin (sandbox carries `allow-same-origin`)
 * so the parent script can:
 *   - mirror data-theme / data-mode into the iframe's <html>, picking
 *     up the active palette from the host page.
 *   - intercept hashchange / popstate to keep the parent breadcrumb
 *     and sidebar in sync as the reader navigates between modules.
 *   - hoist the iframe's per-module #table-of-contents into the
 *     parent's TOC drawer (the in-page Contents card is hidden so it
 *     doesn't double up).
 *
 * Extracted from DocsPage.astro to make the file parser-friendly:
 * prettier-plugin-astro chokes on `<script is:inline>` blocks nested
 * inside JSX-conditional expressions, but a single-element
 * conditional in the caller (`{htmlHref && <HaddockEmbed …/>}`) is
 * parser-safe.
 */

interface Props {
  htmlHref: string;
  title: string;
}

const { htmlHref, title } = Astro.props;
---

<section
  class="docs-haddock-embed not-prose"
  aria-label={`${title} — embedded Haddock HTML`}
>
  <div class="docs-haddock-embed-frame-wrap" data-haddock-frame-wrap>
    <div class="docs-haddock-embed-loader" aria-hidden="true">
      <span class="docs-haddock-embed-loader-eyebrow">Haddock</span>
      <span class="docs-haddock-embed-loader-title"
        >Loading API documentation...</span
      >
    </div>
    <iframe
      class="docs-haddock-embed-frame"
      src={htmlHref}
      title={`${title} — Haddock API documentation`}
      sandbox="allow-same-origin allow-scripts allow-popups"
      loading="eager"></iframe>
    <div class="docs-haddock-embed-fallback" hidden>
      <p class="docs-haddock-embed-fallback-text">
        This page embeds generated Haddock HTML. Your browser can't display it
        inline. <a href={htmlHref} target="_blank" rel="noopener noreferrer"
          >Open it in a new tab</a
        >.
      </p>
    </div>
  </div>
</section>

<script is:inline>
  (() => {
    const wrap = document.querySelector("[data-haddock-frame-wrap]");
    if (!wrap) return;
    const iframe = wrap.querySelector(".docs-haddock-embed-frame");
    const fallback = wrap.querySelector(".docs-haddock-embed-fallback");

    // Mirror the parent's active theme + mode into the iframe so
    // the injected repo-docs-haddock.css picks the right palette.
    function syncTheme() {
      const doc = iframe?.contentDocument;
      if (!doc?.documentElement) return;
      const root = document.documentElement;
      doc.documentElement.dataset.theme = root.dataset.theme ?? "";
      doc.documentElement.dataset.mode = root.dataset.mode ?? "";
    }

    function stripTrailingSlash(value) {
      if (value === "/") return "/";
      return value.endsWith("/") ? value.slice(0, -1) : value;
    }

    function isHaddockSourceLineHash(hash) {
      return /^#(?:L|line-)\d+(?:-(?:L|line-)?\d+)?$/.test(hash || "");
    }

    function haddockRouteParts() {
      if (!iframe) return null;
      const src = new URL(
        iframe.getAttribute("src") || iframe.src,
        window.location.href,
      );
      const marker = "/haddock/";
      const markerIndex = src.pathname.lastIndexOf(marker);
      if (markerIndex === -1) return null;
      const routeBase = src.pathname.slice(0, markerIndex);
      const haddockBase = src.pathname.slice(0, markerIndex + marker.length);
      return { origin: src.origin, routeBase, haddockBase };
    }

    function moduleNameFromHaddockRelativePath(relativePath) {
      const normalized = String(relativePath || "").replace(/^\/+/, "");
      const segments = normalized.split("/").filter(Boolean);
      const basename = segments.at(-1) || "index.html";
      if (
        basename === "index.html" ||
        basename === "doc-index.html" ||
        !basename.endsWith(".html")
      ) {
        return null;
      }
      const stem = decodeURIComponent(basename.slice(0, -".html".length));
      return segments.includes("src") ? stem : stem.replace(/-/g, ".");
    }

    function wrapperPathForHaddockLocation(href) {
      const parts = haddockRouteParts();
      if (!parts) return null;
      const current = new URL(href, window.location.href);
      if (
        current.origin !== parts.origin ||
        !current.pathname.startsWith(parts.haddockBase)
      ) {
        return null;
      }
      const relativePath =
        current.pathname.slice(parts.haddockBase.length) || "index.html";
      const moduleName = moduleNameFromHaddockRelativePath(relativePath);
      if (!moduleName) {
        return `${parts.routeBase}/`;
      }
      const isSourcePage = relativePath.split("/").includes("src");
      const lineHash =
        isSourcePage && isHaddockSourceLineHash(current.hash)
          ? current.hash
          : "";
      const modulePath = moduleName
        .split(".")
        .filter(Boolean)
        .map((segment) => encodeURIComponent(segment))
        .join("/");
      return `${parts.routeBase}/${modulePath}/${lineHash}`;
    }

    function haddockHrefForWrapperPath(pathname, hash = "") {
      const parts = haddockRouteParts();
      if (!parts) return null;
      const target = stripTrailingSlash(pathname);
      const base = stripTrailingSlash(parts.routeBase);
      if (target === base) {
        return `${parts.origin}${parts.haddockBase}index.html`;
      }
      if (!target.startsWith(`${base}/`)) {
        return null;
      }
      const modulePath = target.slice(base.length + 1);
      if (!modulePath) {
        return `${parts.origin}${parts.haddockBase}index.html`;
      }
      const moduleName = modulePath
        .split("/")
        .filter(Boolean)
        .map((segment) => decodeURIComponent(segment))
        .join(".");
      if (!moduleName) return null;
      const lineHash = isHaddockSourceLineHash(hash) ? hash : "";
      const haddockPage = lineHash
        ? `src/${moduleName}.html`
        : `${moduleName.replace(/\./g, "-")}.html`;
      return `${parts.origin}${parts.haddockBase}${haddockPage}${lineHash}`;
    }

    function setNavOpen(key, open) {
      document
        .querySelectorAll(`[data-nav-children-of="${CSS.escape(key)}"]`)
        .forEach((list) => {
          list.dataset.navOpen = open ? "true" : "false";
        });
      document
        .querySelectorAll(`[data-nav-toggle="${CSS.escape(key)}"]`)
        .forEach((toggle) => {
          toggle.setAttribute("aria-expanded", open ? "true" : "false");
        });
    }

    function markSidebarActive(pathname) {
      const target = stripTrailingSlash(pathname);
      let activeLink = null;

      document.querySelectorAll("[data-docs-nav-link]").forEach((link) => {
        const linkPath = stripTrailingSlash(
          new URL(link.href, window.location.href).pathname,
        );
        const active = linkPath === target;
        link.classList.toggle("is-active", active);
        link.classList.remove("has-active-descendant");
        if (active) {
          link.setAttribute("aria-current", "page");
          activeLink = link;
        } else {
          link.removeAttribute("aria-current");
        }
      });

      document
        .querySelectorAll(".docs-nav-group.has-active-descendant")
        .forEach((group) => group.classList.remove("has-active-descendant"));
      document.querySelectorAll("[data-nav-active-path]").forEach((list) => {
        list.dataset.navActivePath = "false";
      });

      if (!activeLink) return;

      let list = activeLink.closest("[data-nav-children-of]");
      while (list) {
        list.dataset.navActivePath = "true";
        const key = list.dataset.navChildrenOf;
        if (key) setNavOpen(key, true);
        const owner = list.parentElement;
        owner
          ?.querySelector(
            ":scope > .docs-nav-row .docs-nav-link, :scope > .docs-nav-row .docs-nav-group",
          )
          ?.classList.add("has-active-descendant");
        list = owner?.parentElement?.closest("[data-nav-children-of]") ?? null;
      }

      activeLink.scrollIntoView({ block: "nearest" });
    }

    function syncParentRouteFromHaddock({ replace = false } = {}) {
      const win = iframe?.contentWindow;
      const href = win?.location?.href;
      if (!href) return;
      const targetRoute = wrapperPathForHaddockLocation(href);
      if (!targetRoute) return;
      const targetUrl = new URL(targetRoute, window.location.href);
      markSidebarActive(targetUrl.pathname);
      if (
        stripTrailingSlash(targetUrl.pathname) ===
          stripTrailingSlash(window.location.pathname) &&
        targetUrl.hash === window.location.hash
      ) {
        return;
      }
      const method = replace ? "replaceState" : "pushState";
      const targetPath = `${targetUrl.pathname}${targetUrl.hash}`;
      window.history[method](
        { repoDocsHaddockPath: targetPath },
        "",
        targetPath,
      );
    }

    let boundHaddockWindow = null;
    function onHaddockHashChange() {
      syncParentRouteFromHaddock();
    }

    function bindHaddockRouteSync() {
      try {
        const win = iframe?.contentWindow;
        if (!win || win === boundHaddockWindow) return;
        boundHaddockWindow?.removeEventListener(
          "hashchange",
          onHaddockHashChange,
        );
        boundHaddockWindow = win;
        boundHaddockWindow.addEventListener("hashchange", onHaddockHashChange);
      } catch {
        /* same-origin denied — non-fatal */
      }
    }

    function syncIframeFromParentRoute() {
      const targetHref = haddockHrefForWrapperPath(
        window.location.pathname,
        window.location.hash,
      );
      if (!targetHref || !iframe) return;
      markSidebarActive(window.location.pathname);
      try {
        const target = new URL(targetHref);
        const win = iframe.contentWindow;
        const currentHref = win?.location?.href;
        const current = currentHref ? new URL(currentHref) : null;
        if (current?.href === target.href) return;
        if (
          current &&
          current.origin === target.origin &&
          current.pathname === target.pathname &&
          target.hash
        ) {
          win.location.hash = target.hash;
          return;
        }
      } catch {
        /* fall through and assign src */
      }
      iframe.src = targetHref;
    }

    // Hoist the iframe's per-module #table-of-contents into the
    // parent shell's TOC drawer. Haddock's in-page Contents card
    // is hidden so it doesn't double up. Re-runs on every iframe
    // load so cross-module navigation refreshes the drawer.
    let scrollSpyDispose = null;
    function syncHaddockToc() {
      const docFrame = iframe?.contentDocument;
      if (!docFrame) return;
      const list = document.querySelector("[data-haddock-toc]");
      if (!list) return;

      const tocEl = docFrame.getElementById("table-of-contents");
      let links = tocEl
        ? Array.from(tocEl.querySelectorAll("#contents-list ul li a"))
        : [];
      if (tocEl) tocEl.style.display = "none";

      // Fallback for modules that don't declare named sections
      // ('-- * Section' headings in haddock comments): pull each
      // top-level declaration's anchor (a.def under #interface
      // .top > p.src) and use those as TOC entries. Strips the
      // 't:' / 'v:' / 'c:' Haddock id-prefix from the visible
      // label so the TOC reads as a clean list of identifiers.
      if (links.length === 0) {
        const declAnchors = Array.from(
          docFrame.querySelectorAll(
            "#interface .top > p.src a.def[id], #interface .top > p.src a[id].def",
          ),
        );
        const seen = new Set();
        const synthetic = [];
        for (const anchor of declAnchors) {
          const id = anchor.getAttribute("id") || "";
          if (!id || seen.has(id)) continue;
          seen.add(id);
          const fakeLink = docFrame.createElement("a");
          fakeLink.setAttribute("href", "#" + id);
          fakeLink.textContent = (anchor.textContent || "").trim();
          synthetic.push(fakeLink);
        }
        if (synthetic.length > 0) links = synthetic;
      }

      list.replaceChildren();
      scrollSpyDispose?.();
      scrollSpyDispose = null;

      const tocAside = document.getElementById("docs-toc");
      if (links.length === 0) {
        if (tocAside) tocAside.hidden = true;
        document.body.dataset.tocEnabled = "false";
        return;
      }
      if (tocAside) tocAside.hidden = false;
      document.body.dataset.tocEnabled = "true";

      const entries = [];
      for (const a of links) {
        const href = a.getAttribute("href") || "";
        const id = href.startsWith("#") ? href.slice(1) : "";
        if (!id) continue;
        const li = document.createElement("li");
        li.className = "docs-toc-item docs-toc-item-d0";
        li.dataset.tocAnchor = id;
        const link = document.createElement("a");
        link.className = "docs-toc-link";
        link.href = href;
        const span = document.createElement("span");
        span.textContent = (a.textContent || "").trim();
        link.appendChild(span);
        li.appendChild(link);
        list.appendChild(li);

        link.addEventListener("click", (ev) => {
          ev.preventDefault();
          const target = docFrame.getElementById(id);
          if (!target) return;
          target.scrollIntoView({ behavior: "smooth", block: "start" });
          try {
            const win = iframe.contentWindow;
            if (win && win.history?.replaceState) {
              win.history.replaceState(null, "", "#" + id);
            } else {
              docFrame.location.hash = id;
            }
          } catch {
            /* same-origin denied — non-fatal */
          }
        });

        const heading = docFrame.getElementById(id);
        if (heading) entries.push({ id, item: li, heading });
      }

      if (entries.length === 0) return;

      const setActive = (id) => {
        for (const entry of entries) {
          entry.item.classList.toggle("is-active", entry.id === id);
        }
      };

      const TRIGGER = 120;
      const scrollWin = iframe.contentWindow;
      function computeActive() {
        let active = null;
        for (const entry of entries) {
          const top = entry.heading.getBoundingClientRect().top;
          if (top <= TRIGGER) {
            active = entry.id;
          } else {
            break;
          }
        }
        if (active === null && (scrollWin?.scrollY ?? 0) < 40) {
          active = entries[0].id;
        }
        setActive(active);
      }

      let scheduled = false;
      function schedule() {
        if (scheduled) return;
        scheduled = true;
        (scrollWin?.requestAnimationFrame ?? window.requestAnimationFrame)(
          () => {
            scheduled = false;
            computeActive();
          },
        );
      }

      scrollWin?.addEventListener("scroll", schedule, { passive: true });
      scrollWin?.addEventListener("resize", schedule);
      computeActive();
      scrollSpyDispose = () => {
        scrollWin?.removeEventListener("scroll", schedule);
        scrollWin?.removeEventListener("resize", schedule);
      };
    }

    if (iframe) {
      iframe.addEventListener("load", () => {
        wrap.dataset.loaded = "true";
        syncTheme();
        bindHaddockRouteSync();
        syncParentRouteFromHaddock();
        syncHaddockToc();
      });
      iframe.addEventListener("error", () => {
        if (fallback) fallback.hidden = false;
        wrap.dataset.failed = "true";
      });
      if (isHaddockSourceLineHash(window.location.hash)) {
        syncIframeFromParentRoute();
      }
    }

    window.addEventListener("popstate", syncIframeFromParentRoute);
    window.addEventListener("hashchange", syncIframeFromParentRoute);

    // Re-sync whenever the reader toggles the theme button.
    document.addEventListener("repodocs:mode-change", syncTheme);
  })();
</script>
