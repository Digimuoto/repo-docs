---
import type { MarkdownHeading } from "astro";
import { filterHeadings, minVisibleDepth } from "../lib/headings";

interface Props {
  headings: MarkdownHeading[];
  minDepth?: number;
  maxDepth?: number;
}

const { headings, minDepth = 2, maxDepth = 4 } = Astro.props;

const visible = filterHeadings(headings, { minDepth, maxDepth });
const baseDepth = minVisibleDepth(visible, { maxDepth });
---

{
  visible.length > 0 && (
    <nav class="docs-toc-nav" aria-label="On this page">
      <p class="docs-toc-eyebrow">On this page</p>
      <ol class="docs-toc-list">
        {visible.map((heading) => (
          <li
            class={`docs-toc-item docs-toc-item-d${heading.depth - baseDepth}`}
            data-toc-anchor={heading.slug}
          >
            <a class="docs-toc-link" href={`#${heading.slug}`}>
              <span>{heading.text}</span>
            </a>
          </li>
        ))}
      </ol>
    </nav>
  )
}
